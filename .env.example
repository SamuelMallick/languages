# ChatGPT uses Continue with ChatGPT in Settings; no AI API key is used.
# The server stays on 127.0.0.1, including when Tailscale is enabled.
PORT=3000
# Optional private iPad access through Tailscale Serve (set BOTH; see README.md).
# Use the exact HTTPS address printed by `tailscale serve`, without a path.
# TAILSCALE_ORIGIN=https://your-computer.your-tailnet.ts.net
# TAILSCALE_LOGIN=your-personal-tailscale-login@example.com
# ANKI_CONNECT_KEY=
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
